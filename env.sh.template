# Extra environment variables for Sockudo. This file is sourced on every app start.
# Full list: https://sockudo.io/docs/reference/environment-variables
# Restart the app after editing.

# Redis: by default the Cloudron Redis addon is used. To use an external Redis server instead
# (for example the Redis Cloudron app from this repository), set its URL. rediss:// enables TLS.
# export SOCKUDO_REDIS_URL="rediss://default:PASSWORD@redis.example.com:6380/0"
# Only for servers with a self-signed certificate:
# export DATABASE_REDIS_MASTER_TLS_CA_PATH=/app/data/redis-ca.pem
# When several Sockudo installations share one Redis, give each its own database number
# (the /0 at the end of the URL).

# export RUST_LOG=info
# export LOG_OUTPUT_FORMAT=json
# export SOCKUDO_MAX_CONNECTIONS=0
# export HTTP_API_USAGE_ENABLED=true
