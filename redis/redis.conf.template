# Generated by start.sh on every start - edit /app/data/redis.conf instead.

daemonize no
logfile ""
dir /app/data/redis

bind * -::*
protected-mode yes
port 0
__TLS_SETTINGS__

unixsocket /run/redis/redis.sock
unixsocketperm 700

requirepass "__PASSWORD__"

appendonly yes
appendfsync everysec
save 3600 1 300 100 60 10000

maxmemory __MAXMEMORY__
maxmemory-policy noeviction

include /app/data/redis.conf
